# ---------------------------------------------------------------------------
# 生图服务（TokenWorld API）—— 仅服务端读取，不会进入前端产物
# 注册地址: https://tokenworldai.com/  ->  控制台 -> 令牌管理
# ---------------------------------------------------------------------------
TOKENWORLD_API_KEY=sk-your-token-here
TOKENWORLD_BASE_URL=https://tokenworldai.com/v1

# 生图默认模型。本令牌分组下最便宜的图像模型为 `gpt-image-2`（$0.10 / 次）。
# 同分组可选：gpt-image-2.5-flare、gpt-image-2.5-sunburst（均为 $0.15 / 次）
TOKENWORLD_IMAGE_MODEL=gpt-image-2

# Node 生图服务端口（Vite 开发服务器会把 /api 代理到这里）
PORT=8788