{
  "name": "spice-and-wolf-web",
  "private": true,
  "version": "0.1.0",
  "description": "《狼与香辛料》主题站 —— 动画资讯、人物图鉴、世界观与 AI 生图画廊",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:pages": "vite --mode pages",
    "build:pages": "vue-tsc --noEmit && vite build --mode pages && node scripts/pages-extra.mjs",
    "preview:pages": "vite preview --mode pages",
    "dev:server": "node --watch server/index.js",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --experimental-strip-types --test src/game/engine.test.ts src/game/layout.test.ts",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write \"**/*.{ts,vue,css,json,md,js,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,css,json,md,js,mjs}\"",
    "gen:image": "node scripts/generate-image.mjs"
  },
  "dependencies": {
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "pinia": "^4.0.3",
    "three": "^0.186.1",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vue-tsc": "^3.3.12"
  }
}
